# CORA environment template. Copy to .env (gitignored) and fill in.
# NEVER put access keys here: credentials come from AWS IAM Identity Center (SSO) profiles.

# Personal AWS account (Bedrock, later S3/Athena) - see documentation/AWS_SETUP.md
AWS_PROFILE=cora-dev
AWS_REGION=us-east-1

# Bedrock inference profile ids - copy exact ids from `aws bedrock list-inference-profiles`
CORA_BEDROCK_MODEL_ID=
CORA_BEDROCK_JUDGE_MODEL_ID=
CORA_BEDROCK_FALLBACK_MODEL_ID=

# Mock identity service (task 2.1). HMAC key that signs session JWTs - a secret, so leave it
# blank here and set it in the gitignored .env. The mock IdP fails closed when it is unset.
CORA_IDENTITY_SIGNING_KEY=
# Session TTL in minutes - absolute expiry from login (default 15 when blank/unset).
CORA_IDENTITY_SESSION_TTL_MINUTES=

# Organizer datathon bucket (read-only, separate profile configured outside the repo)
CORA_DATATHON_PROFILE=cora-datathon
CORA_DATATHON_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
CORA_DATATHON_REGION=us-east-2

# Cost assumptions used by the smoke test and the eval report (USD per 1K tokens, from the Bedrock pricing page)
CORA_PRICE_INPUT_PER_1K=
CORA_PRICE_OUTPUT_PER_1K=
