  "cards": [
    {
      "dot": "emerald",
      "title": "Primary learning path (REQ-31)",
      "items": [
        "Team-written es/pt gold set (transcripts seed-only, F7) feeds one leakage-safe split",
        "Groups split by source scenario and authoring wave, with cosine>0.95 cross-split dedup",
        "MiniLM+LogReg head trains on train; a TF-IDF char-ngram head is the no-cross-lingual comparison"
      ]
    },
    {
      "dot": "rose",
      "title": "Frozen before test (REQ-47)",
      "items": [
        "Cost-matrix thresholds selected on validation and frozen before the test split is touched",
        "tau_escalate <= tau_clarify matches the engine's POL-060-before-POL-070 band order",
        "All numbers are offline measurement; the MiniLM-head run is stub-provenance here, TF-IDF is real"
      ]
    },
    {
      "dot": "violet",
      "title": "Learned proposes, policy decides",
      "items": [
        "PII is masked, then language id and the injection screen run fail-closed at serve time",
        "The classifier fills exactly three PolicyInput fields: intent, confidence, injection_hit",
        "The deterministic PolicyEngine makes the decision; the model never does (security steering)"
      ]
    }
  ]
