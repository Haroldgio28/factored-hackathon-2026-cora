    "wired_at": "task 3.7",
    "wired": true,
    "seam": "cora.nlu.language.detect(text) -> LanguageResult(lang in {es,pt,other}, confidence, low_confidence); StubDetector under CORA_NLU_STUB=1 (tested path)",
    "fail_closed": "low/mixed confidence or non-es/pt result flags low_confidence -> keep session language and confirm, never guess a third language (REQ-18)"
